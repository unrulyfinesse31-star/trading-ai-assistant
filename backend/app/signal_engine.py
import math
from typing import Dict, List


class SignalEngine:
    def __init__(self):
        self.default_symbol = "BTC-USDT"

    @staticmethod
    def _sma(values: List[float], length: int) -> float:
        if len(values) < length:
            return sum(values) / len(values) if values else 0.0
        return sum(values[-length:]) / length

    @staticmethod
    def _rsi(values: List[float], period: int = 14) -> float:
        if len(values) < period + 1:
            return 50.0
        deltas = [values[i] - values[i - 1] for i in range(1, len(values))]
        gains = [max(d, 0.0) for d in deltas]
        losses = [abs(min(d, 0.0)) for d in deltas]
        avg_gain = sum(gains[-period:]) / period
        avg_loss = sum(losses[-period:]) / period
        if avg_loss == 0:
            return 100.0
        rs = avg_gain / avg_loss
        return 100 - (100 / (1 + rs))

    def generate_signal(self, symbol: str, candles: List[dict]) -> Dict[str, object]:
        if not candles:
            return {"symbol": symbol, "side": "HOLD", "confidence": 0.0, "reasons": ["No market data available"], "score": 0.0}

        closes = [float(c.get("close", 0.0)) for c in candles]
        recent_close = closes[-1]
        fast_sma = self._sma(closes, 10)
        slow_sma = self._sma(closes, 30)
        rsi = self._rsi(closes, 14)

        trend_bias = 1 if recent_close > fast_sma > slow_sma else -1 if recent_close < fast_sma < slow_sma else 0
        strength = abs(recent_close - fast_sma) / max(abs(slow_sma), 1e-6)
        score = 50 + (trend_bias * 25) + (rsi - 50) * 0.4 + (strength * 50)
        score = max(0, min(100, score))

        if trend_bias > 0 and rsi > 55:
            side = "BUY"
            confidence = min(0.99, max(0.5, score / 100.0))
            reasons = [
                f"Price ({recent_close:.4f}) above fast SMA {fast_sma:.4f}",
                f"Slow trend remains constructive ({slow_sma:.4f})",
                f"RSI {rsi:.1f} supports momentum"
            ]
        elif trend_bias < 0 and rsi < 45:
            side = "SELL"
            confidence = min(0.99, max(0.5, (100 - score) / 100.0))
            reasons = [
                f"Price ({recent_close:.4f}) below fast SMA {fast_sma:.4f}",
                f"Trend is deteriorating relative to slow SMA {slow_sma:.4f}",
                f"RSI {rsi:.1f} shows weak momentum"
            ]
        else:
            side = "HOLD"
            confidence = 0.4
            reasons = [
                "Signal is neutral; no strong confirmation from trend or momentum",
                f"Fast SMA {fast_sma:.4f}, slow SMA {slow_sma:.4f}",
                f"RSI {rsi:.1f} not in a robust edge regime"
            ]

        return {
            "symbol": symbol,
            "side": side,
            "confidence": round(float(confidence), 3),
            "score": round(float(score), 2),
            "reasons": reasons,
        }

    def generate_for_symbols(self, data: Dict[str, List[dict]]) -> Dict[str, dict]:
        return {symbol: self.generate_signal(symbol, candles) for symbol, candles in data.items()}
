from dataclasses import dataclass, field
from typing import Dict, List


@dataclass
class RiskCheckResult:
    allowed: bool
    reason: str = ""


class RiskManager:
    def __init__(self, max_leverage: float = 1.0, max_position_per_symbol: float = 0.15, max_daily_loss: float = 0.03, max_drawdown: float = 0.08):
        self.max_leverage = max_leverage
        self.max_position_per_symbol = max_position_per_symbol
        self.max_daily_loss = max_daily_loss
        self.max_drawdown = max_drawdown
        self.daily_pnl = 0.0
        self.equity = 100000.0

    def evaluate_trade(self, symbol: str, side: str, quantity: float, mark_price: float, current_positions: Dict[str, float], current_equity: float) -> RiskCheckResult:
        if quantity <= 0:
            return RiskCheckResult(False, "Quantity must be positive")
        if side not in {"BUY", "SELL"}:
            return RiskCheckResult(False, "Side must be BUY or SELL")

        notional = quantity * mark_price
        share_pct = notional / max(current_equity, 1.0)
        if share_pct > self.max_position_per_symbol:
            return RiskCheckResult(False, f"Position exceeds max position limit: {share_pct:.2%} > {self.max_position_per_symbol:.2%}")

        if current_positions.get(symbol, 0.0) * (1 if side == "BUY" else -1) > 0:
            total_position = abs(current_positions[symbol]) + quantity
            if total_position * mark_price / max(current_equity, 1.0) > self.max_position_per_symbol * 1.5:
                return RiskCheckResult(False, "Aggregate position concentration too high")

        if self.daily_pnl <= -self.max_daily_loss * self.equity:
            return RiskCheckResult(False, "Daily loss limit reached; trading halted")

        if current_equity <= 0:
            return RiskCheckResult(False, "Equity is invalid")

        return RiskCheckResult(True, "Risk checks passed")

    def update_daily_pnl(self, pnl_delta: float):
        self.daily_pnl += pnl_delta
